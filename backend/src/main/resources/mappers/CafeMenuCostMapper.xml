<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.coffemoa.domain.finance.mapper.CafeMenuCostMapper">

  <select id="select" parameterType="map"
    resultType="com.coffemoa.domain.finance.entity.CafeMenuCost">
    SELECT
    `메뉴명` AS menuName,
    `온도구분` AS temperatureType,
    `사이즈구분` AS sizeType,
    `레시피` AS recipe,
    `총원가` AS totalCost,
    `판매가` AS price,
    `원가율` AS costRate
    FROM `vw_메뉴원가정보_2`
    <where>
      <if test="menuName != null and menuName != ''">
        AND `메뉴명` = #{menuName}
      </if>
      <if test="temperatureType != null and temperatureType != ''">
        AND `온도구분` = #{temperatureType}
      </if>
      <if test="sizeType != null and sizeType != ''">
        AND `사이즈구분` = #{sizeType}
      </if>
    </where>

  </select>

</mapper>
