<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.coffemoa.domain.standard.mapper.CafeMenuPriceMapper">

  <!-- ✅ 메뉴 가격 등록 -->
  <insert id="insert" parameterType="map">
    INSERT INTO `메뉴종류` (
    `메뉴명`,
    `온도구분`,
    `사이즈구분`,
    `판매가`
    )
    VALUES (
    #{cafeMenuName},
    #{temperature},
    #{size},
    #{price}
    )
  </insert>

  <!-- ✅ 메뉴 가격 조회 -->
  <select id="select" parameterType="map"
    resultType="com.coffemoa.domain.standard.entity.CafeMenuPrice">
    SELECT
    `메뉴명` AS cafeMenuName,
    `온도구분` AS temperature,
    `사이즈구분` AS size,
    `판매가` AS price
    FROM `메뉴종류`
    <where>
      <if test="cafeMenuName != null and cafeMenuName != ''">
        AND `메뉴명` = #{cafeMenuName}
      </if>
      <if test="temperature != null and temperature != ''">
        AND `온도구분` = #{temperature}
      </if>
      <if test="size != null and size != ''">
        AND `사이즈구분` = #{size}
      </if>
    </where>
  </select>

  <!-- ✅ 메뉴 가격 수정 -->
  <update id="update" parameterType="map">
    UPDATE `메뉴종류`
    SET `판매가` = #{price}
    WHERE `메뉴명` = #{cafeMenuName}
    AND `온도구분` = #{temperature}
    AND `사이즈구분` = #{size}
  </update>

  <!-- ✅ 메뉴 가격 삭제 -->
  <delete id="delete" parameterType="map">
    DELETE FROM `메뉴종류`
    <where>
      <if test="cafeMenuName != null and cafeMenuName != ''">
        AND `메뉴명` = #{cafeMenuName}
      </if>
      <if test="temperature != null and temperature != ''">
        AND `온도구분` = #{temperature}
      </if>
      <if test="size != null and size != ''">
        AND `사이즈구분` = #{size}
      </if>
    </where>
  </delete>

</mapper>
